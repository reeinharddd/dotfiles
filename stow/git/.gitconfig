[user]
	name = Erik Alfonso Beltran Ramirez
	email = beltraberik@gmail.com
	signingkey = D4C03D5A373C9C78
[init]
	defaultBranch = main
[core]
	editor = code --wait
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[push]
	autoSetupRemote = true
	autosetupremote = true
[pull]
	rebase = true
[credential]
	helper = cache --timeout=3600
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /usr/bin/ssh
