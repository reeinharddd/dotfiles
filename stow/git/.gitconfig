[user]
	name = Erik Alfonso Beltran Ramirez
	email = beltraberik@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[core]
	editor = code --wait
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[push]
	autoSetupRemote = true
	autosetupremote = true
[pull]
	rebase = true
[credential]
	helper = cache --timeout=3600
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /usr/bin/ssh-keygen
	allowedSignersFile = ~/.ssh/allowed_signers
[safe]
	directory = /var/www/wordpress-project
	directory = /home/reeinharrrd/School/servease-wordpress
