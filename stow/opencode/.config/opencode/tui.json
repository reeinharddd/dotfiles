{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "opencode",
  "diff_style": "auto",
  "mouse": true,
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.3
  },
  "plugin": [
    "opencode-subagent-statusline",
    "oh-my-openagent@latest",
    "oh-my-openagent@4.19.4",
    "opencode-workspaces",
    "opencode-vibeguard",
    "opencode-yaml-hooks",
    "opencode-dcp"
  ]
}
