   ]
  },
  "momus": {
   "model": "mistral/mistral-medium-latest",
   "mode": "primary",
   "description": "Crítico adversarial de planes que audita completitud, claridad y verificabilidad antes de implementar.",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731",
    "google/antigravity-claude-sonnet-4-6"
   ]
  },
  "sisyphus-junior": {
   "model": "nvidia/deepseek-ai/deepseek-v4-flash-0731",
   "mode": "primary",
   "description": "Ejecutor enfocado de tareas atómicas directas sin subdelegación.",
   "fallback_models": [
    "mistral/ministral-8b-latest",
    "google/gemini-3.5-flash-lite",
    "google/gemini-2.5-flash-lite"
   ]
  },
  "consult": {
   "model": "nvidia/deepseek-ai/deepseek-v4-flash-0731",
   "mode": "primary",
   "description": "Read-only consultant de arquitectura y debugging duro (reemplazo seleccionable de oracle).",
   "fallback_models": [
    "google/antigravity-claude-sonnet-4-6",
    "mistral/mistral-medium-latest",
    "google/gemini-3.8-flash",
    "openrouter/dots-studio/dots-3-note-preview:free"
   ]
  },
  "plan-critic": {
   "model": "mistral/mistral-medium-latest",
   "mode": "primary",
   "description": "Crítico de planes (equivalente seleccionable de metis/momus).",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731",
    "google/antigravity-claude-sonnet-4-6",
    "openrouter/dots-studio/dots-3-note-preview:free"
   ]
  },
  "senior-researcher": {
   "model": "google/gemini-3.8-flash",
   "mode": "primary",
