{
 "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
 "telemetry": false,
 "hashline_edit": true,
 "model_fallback": true,
 "auto_update": false,
 "disabled_providers": [
  "openai",
  "opencode-go",
  "minimax",
  "groq",
  "cerebras",
  "anthropic",
  "github-copilot",
  "fireworks",
  "deepinfra",
  "huggingface",
  "ollama-cloud",
  "together",
  "siliconflow",
  "novita",
  "anyapi"
 ],
 "default_run_agent": "smart",
 "disabled_agents": [],
 "agents": {
  "general": {
   "model": "nvidia/deepseek-ai/deepseek-v4-flash-0731",
   "mode": "primary",
   "description": "Agente de trabajo general resiliente para delegaciones en segundo plano.",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "mistral/mistral-medium-latest",
    "openrouter/dots-studio/dots-3-note-preview:free"
   ]
  },
  "build": {
   "model": "opencode-zen/nemotron-3-ultra-free",
   "mode": "primary",
   "description": "Agente ejecutor de compilación, suites de tests y flujos de build multi-etapa en consola.",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "mistral/mistral-medium-latest",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731"
   ]
  },
  "smart": {
   "model": "opencode-zen/nemotron-3-ultra-free",
   "mode": "primary",
   "description": "Agente orquestador interactivo principal para codificación, resolución de problemas y coordinación.",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "mistral/mistral-medium-latest",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731"
   ]
  },
  "fast": {
   "model": "google/gemini-3.5-flash-lite",
   "mode": "primary",
   "description": "Agente ligero para tareas triviales, corrección de tipografías y modificaciones de un solo archivo.",
   "fallback_models": [
    "mistral/ministral-8b-latest",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731",
    "google/gemini-2.5-flash-lite"
   ]
  },
  "oracle": {
   "model": "nvidia/deepseek-ai/deepseek-v4-flash-0731",
   "mode": "primary",
   "description": "Consultor de razonamiento profundo para decisiones de arquitectura, debugging complejo y tradeoffs (read-only).",
   "fallback_models": [
    "google/antigravity-claude-sonnet-4-6",
    "mistral/mistral-medium-latest",
    "google/gemini-3.8-flash"
   ]
  },
  "plan": {
   "model": "opencode-zen/nemotron-3-ultra-free",
   "mode": "primary",
   "description": "Especialista en arquitectura y diseño que descompone requisitos en planes de implementación atómicos.",
   "fallback_models": [
    "mistral/mistral-medium-latest",
    "google/gemini-3.8-flash",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731"
   ]
  },
  "code-reviewer": {
   "model": "mistral/mistral-medium-latest",
   "mode": "primary",
   "description": "Revisor de código para análisis de diffs, bugs de lógica, seguridad, estilo y adherencia a convenciones.",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731"
   ]
  },
  "security-reviewer": {
   "model": "mistral/mistral-medium-latest",
   "mode": "primary",
   "description": "Especialista en investigación de seguridad, análisis de superficie de ataque, autenticación y validación de exploits.",
   "fallback_models": [
    "google/gemini-3.8-flash",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731"
   ]
  },
  "explore": {
   "model": "google/gemini-3.5-flash-lite",
   "mode": "primary",
   "description": "Explorador rápido de codebase para búsqueda contextual y navegación de símbolos y dependencias.",
   "fallback_models": [
    "nvidia/deepseek-ai/deepseek-v4-flash-0731",
    "mistral/ministral-8b-latest",
    "google/gemini-3.8-flash"
   ]
  },
  "scout": {
   "model": "google/gemini-3.5-flash-lite",
   "mode": "primary",
