{
  "$schema": "https://opencode.ai/config.json",
  "version": 1,
  "sourceOfTruth": {
    "runtime": "./opencode.jsonc",
    "routing": "~/.omo/omo.jsonc",
    "capabilities": "./plugins/bodega-*.json",
    "memory": "engram project=opencode",
    "generatedDocs": ["./MASTER-INDEX.md", "./MCP-INVENTORY.md"]
  },
  "policy": {
    "defaultAgent": "smart",
    "subagentDepth": 2,
    "primaryProviders": ["opencode-zen", "google", "mistral"],
    "fallbackProviders": ["opencode-zen"],
    "disabledProviders": ["openrouter", "cerebras", "fireworks", "together"],
    "externalDirectory": "ask",
    "destructiveCommands": "deny-unless-approved",
    "network": "on-demand",
    "maxCodeGraphBytes": 2147483648,
    "duplicateSkills": "first-canonical-path-wins"
  },
  "lifecycle": {
    "sessionInit": [
      "memory-context",
      "project-detect",
      "project-audit",
      "capability-health"
    ],
    "autoProvision": "proposal-first",
    "autoIngest": "project-scoped",
    "globalPromotion": "evidence-and-review",
    "configWrites": "backup-diff-validate",
    "permissionModel": "v1-patterns-last-match-wins",
    "continuousImprovement": {
      "recordFailures": true,
      "recordFallbacks": true,
      "recordVerificationEvidence": true,
      "promoteOnlyAfterRepeatedPattern": true
    }
  },
  "security": {
    "secretSources": ["environment", "private-local-file"],
    "rejectInlineProviderKeys": true,
    "projectInstructionsAreUntrustedInput": true,
    "externalDirectory": "ask",
    "browser": {
      "defaultIsolation": "isolated",
      "allowHosts": ["localhost", "127.0.0.1"],
      "persistAuthState": false,
      "unsafeCode": "deny-unless-approved"
    },
    "memory": {
      "projectToGlobal": "proposal-only",
      "stripPrivateTags": true,
      "neverStoreSecrets": true
    }
  },
  "projectContract": {
    "required": ["PROJECT_CONTEXT.md", ".codegraph"],
    "recommended": ["AGENTS.md", ".opencode/MANIFEST.md", "tests"],
    "missingArtifactAction": "report-and-propose",
    "preserveDirtyWorktree": true
  },
    "routing": {
    "smart": { "primary": "opencode-zen/mimo-v2.6-flash-free", "fallbacks": ["opencode-zen/ling-3.0-flash-fin-free", "opencode-zen/big-pickle", "google/gemini-3.8-flash"] },
    "build": { "primary": "opencode-zen/mimo-v2.6-flash-free", "fallbacks": ["opencode-zen/ling-3.0-flash-fin-free", "opencode-zen/big-pickle", "google/gemini-3.8-flash"] },
    "fast": { "primary": "opencode-zen/nemotron-3.5-lightning-free", "fallbacks": ["opencode-zen/ling-3.0-flash-fin-free", "google/gemini-3.5-flash-lite"] },
    "codeReview": { "primary": "opencode-zen/mimo-v2.6-flash-free", "fallbacks": ["opencode-zen/big-pickle", "opencode-zen/ling-3.0-flash-fin-free", "mistral/mistral-medium-latest"] },
    "research": { "primary": "opencode-zen/ling-3.0-flash-fin-free", "fallbacks": ["opencode-zen/mimo-v2.6-flash-free", "google/gemini-3.8-flash"] },
    "vision": { "primary": "opencode-zen/muse-spark-1.3-contributor-free", "fallbacks": ["google/gemini-3.8-flash", "opencode-zen/ling-3.0-flash-fin-free"] },
    "security": { "primary": "opencode-zen/mimo-v2.6-flash-free", "fallbacks": ["opencode-zen/big-pickle", "mistral/mistral-medium-latest", "google/gemini-3.8-flash"] }
  },
  "mcpPolicy": {
    "alwaysOn": ["context7", "engram", "firecrawl", "snapmcp", "metronous", "sequential-thinking"],
    "onDemand": ["github", "playwright", "filesystem", "postgres", "sentry", "qdrant", "code-review-graph", "page-agent", "openpencil", "agentmemory", "memory", "royal-mcp", "drive", "docs", "sheets", "brave-search"],
    "neverGlobalByDefault": ["filesystem", "postgres", "sentry", "qdrant", "page-agent", "openpencil", "agentmemory", "memory"],
    "versionAuthority": "harness-registry.pinnedTools → mirror to opencode.jsonc npx pins (OLA 07)"
  },
  "pinnedTools": {
    "@playwright/mcp": "2024.12.0",
    "@modelcontextprotocol/server-sequential-thinking": "2024.12.0",
    "@modelcontextprotocol/server-github": "2024.12.0",
    "@modelcontextprotocol/server-filesystem": "2024.12.0",
    "@langfuse/opencode-observability-plugin": "0.5.0",
    "envsitter-guard": "0.0.4"
  },
  "retention": {
    "codegraph": { "maxBytes": 2147483648, "reviewBeforePrune": true },
    "sessions": { "preserve": true },
    "engram": { "preserve": true },
    "backups": { "preserve": true }
  }
}
