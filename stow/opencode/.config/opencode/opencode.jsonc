{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/zsh",
  "autoupdate": false,
  "instructions": [
    "instructions/00-global-contract.md",
    "instructions/00-memory-policy.md",
    "instructions/01-initialization.md",
    "instructions/02-hard-rules.md",
    "instructions/03-quality-gates.md",
    "instructions/04-mcp-tools.md",
    "instructions/05-yagni.md",
    "instructions/06-opencode-ops.md"
  ],
  "model": "google/gemini-3.8-flash",
  "small_model": "opencode-zen/nemotron-3-ultra-free",
  "default_agent": "smart",
  "subagent_depth": 2,
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000,
    "tail_turns": 5,
    "preserve_recent_tokens": 30000
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "watcher": {
    "globs": [
      "**"
    ],
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".angular/**",
      "__pycache__/**",
      ".venv/**",
      "venv/**",
      ".cache/**",
      "*.lock",
      "**/*.log",
      "coverage/**",
      ".turbo/**",
      "*.tsbuildinfo"
    ]
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.ssh/*": "deny",
      "*/sops/*": "deny",
      "*auth.json": "deny"
    },
    "edit": {
      "*": "allow",
      "*opencode.jsonc": "ask",
      "*/.github/workflows/*": "ask",
      "*/.git/hooks/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "git push*": "ask",
      "curl *": "ask",
      "rm *": "deny",
      "sudo *": "deny"
    },
    "webfetch": "ask",
    "external_directory": "ask"
  },
  "experimental": {
    "openTelemetry": true
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://localhost:4000/v1"
      },
      "models": {
        "claude-3-5-sonnet": {
          "name": "Claude 3.5 Sonnet",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-2-5-pro": {
          "name": "Gemini 2.5 Pro",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-r1": {
          "name": "DeepSeek R1"
        }
      }
    },
    "opencode-zen": {
      "name": "OpenCode Zen",
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle",
          "limit": {
