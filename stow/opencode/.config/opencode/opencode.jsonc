  "lsp": {
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "dockerfile": {
      "command": [
        "docker-langserver",
        "--stdio"
      ],
      "extensions": [
        "Dockerfile"
      ]
    },
    "go": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "javascript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx"
      ]
    },
    "json": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "markdown": {
      "command": [
        "marksman"
      ],
      "extensions": [
        ".md"
      ]
    },
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "toml": {
      "command": [
        "taplo",
        "lsp",
        "--stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "yaml": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "sql": {
      "command": [
        "sql-language-server",
        "up",
        "--method",
        "stdio"
      ],
      "extensions": [
        ".sql",
        ".pgsql"
      ]
    }
  },
  "formatter": {
    "python": {
      "command": [
        "ruff",
