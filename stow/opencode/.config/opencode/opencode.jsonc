        "{path}"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "markdown": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
      ],
      "extensions": [
        ".md"
      ]
    },
    "yaml": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "go": {
      "command": [
        "gofmt"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
