        ".py"
      ]
    },
    "shell": {
      "command": [
        "shfmt",
        "-"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "javascript": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
