  // ── AGENT TAXONOMY (OLA 09) — OMO is sole agent/model routing authority ──
  // 00-global-contract §Tools: "Model/agent routing, fallback, orchestration → OMO"
  // This block provides OpenCode runtime agent definitions; OMO owns all routing/fallback/orchestration.
  // No model values here override OMO — see oh-my-openagent.json for authoritative models.
  "agent": {
    // ═══════ CORE — always available, primary workflow agents ═══════
    "build": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Agente ejecutor de compilación, tests y flujos de build multi-etapa en consola."
    },
    "smart": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Agente orquestador interactivo principal para codificación y coordinación."
    },
    "general": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Agente de trabajo general resiliente para delegaciones en segundo plano."
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Especialista en arquitectura que descompone requisitos en planes atómicos."
    },
    "fast": {
      "mode": "primary",
      "model": "opencode-zen/nemotron-3.5-lightning-free",
      "description": "Agente ligero para tareas triviales y un solo archivo."
    },
    // ── ON-DEMAND — skill-router/bodega domain experts ──
    "code-reviewer": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Revisor de código: bugs, seguridad, calidad y convenciones."
    },
    "security-reviewer": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Especialista en seguridad: superficie de ataque, auth y exploits."
    },
    "tdd-guide": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Guía TDD red-green-refactor para features y bugfixes."
    },
    "qa-enforcer": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Aseguramiento de calidad y verificación antes de completar."
    },
    "oracle": {
      "mode": "primary",
      "model": "opencode-zen/nemotron-3-ultra-free",
      "description": "Consultor de razonamiento profundo para arquitectura y debugging complejo (read-only)."
    },
    "metis": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Consultor pre-planificación para análisis y tradeoffs (read-only)."
    },
    "momus": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Crítico de planes: revisa diseño antes de implementar (read-only)."
    },
    "consult": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Segunda opinión experta para decisiones difíciles (read-only)."
    },
    "plan-critic": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Crítico de planes de implementación."
    },
    "senior-researcher": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Investigación profunda con razonamiento (read-only)."
    },
    "subagent-orchestrator": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Orquestador de subagentes paralelos para tareas independientes."
    },
    "explore": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Explorador rápido de codebase: símbolos y dependencias."
    },
    "scout": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Explorador ligero de estructuras y puntos de entrada."
    },
    "docs-lookup": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Búsqueda de documentación y referencia externa."
    },
    "librarian": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Bibliotecario de contexto y referencias del proyecto."
    },
    // ── EXTERNAL — OMO-owned specialized agents (team_mode, .omo categories, vision) ──
    "sisyphus-junior": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Ejecutor rápido de tareas delegadas en background."
    },
    "vision": {
      "mode": "primary",
      "model": "opencode-zen/muse-spark-1.3-contributor-free",
      "description": "Análisis visual: diagramas, imágenes y mockups."
    },
    "multimodal-looker": {
      "mode": "primary",
      "model": "opencode-zen/muse-spark-1.3-contributor-free",
      "description": "Extractor de información visual para look_at."
    },
    "prometheus": {
      "mode": "primary",
      "model": "opencode-zen/mimo-v2.6-flash-free",
      "description": "Prometheus - Plan Builder: coordinador de modo plan (.omo/*.md only)."
    },
    "atlas": {
      "mode": "primary",
      "model": "opencode-zen/ling-3.0-flash-fin-free",
      "description": "Atlas (Plan Executor): ejecución de planes autorizados (read-only)."
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "enabled": true,
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_KEY}/v2/mcp"
    },
    "snapmcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "snapmcp"
      ]
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2024.12.0"
      ]
    },
    "metronous": {
      "enabled": true,
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=metronous"
      ]
    },
    "github": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github@2024.12.0"
      ]
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@2024.12.0"
      ]
    },
    "filesystem": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2024.12.0",
        "$HOME/projects"
      ]
    }
  }
}