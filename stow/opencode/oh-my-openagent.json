 "experimental": {
  "dynamic_context_pruning": {
   "enabled": true,
   "notification": "minimal",
   "turn_protection": {
    "enabled": true,
    "turns": 4
   },
   "protected_tools": [
    "task",
    "skill",
    "todowrite",
    "todoread",
    "lsp_rename",
    "session_read",
    "session_write",
    "session_search",
    "codegraph_explore",
    "codegraph_node"
   ],
   "strategies": {
    "deduplication": {
     "enabled": true
    },
    "supersede_writes": {
     "enabled": true,
     "aggressive": false
    },
    "purge_errors": {
     "enabled": true,
     "turns": 3
    }
   }
  },
  "aggressive_truncation": true,
  "truncate_all_tool_outputs": false
 },
 "team_mode": {
  "enabled": true,
  "tmux_visualization": false,
  "max_parallel_members": 4,
  "max_members": 8,
  "max_messages_per_run": 10000,
  "max_wall_clock_minutes": 120,
  "max_member_turns": 500,
  "message_payload_max_bytes": 32768,
  "recipient_unread_max_bytes": 262144,
  "mailbox_poll_interval_ms": 3000
 },
 "background_task": {
  "defaultConcurrency": 5,
  "maxDepth": 2,
  "staleTimeoutMs": 600000,
  "messageStalenessTimeoutMs": 600000,
  "taskTtlMs": 1800000,
  "sessionGoneTimeoutMs": 10000,
  "syncPollTimeoutMs": 60000,
  "maxToolCalls": 200,
  "circuitBreaker": {
   "enabled": true,
   "maxToolCalls": 200,
   "consecutiveThreshold": 10
  }
 },
 "websearch": {
  "provider": "exa"
 },
 "codegraph": {
  "enabled": true,
  "auto_init": true,
  "auto_provision": true,
  "watch_debounce_ms": 1000
 },
 "sisyphus_agent": {
  "tdd": true,
  "default_builder_enabled": false,
  "planner_enabled": true
 },
 "comment_checker": {
  "enabled": true
 },
 "monitor": {
  "enabled": false
 },
 "hooks": {
  "pre_compaction_save": {
   "enabled": true,
   "command": "pre-compaction-save"
  },
  "auto_protect_wrap": {
   "enabled": true,
   "command": "auto-protect-wrap"
  },
  "auto_extract": {
   "enabled": true,
   "command": "auto-extract"
  }
 }
