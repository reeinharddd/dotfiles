{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/zsh",
  "autoupdate": false,
  "model": "google/gemini-3.8-flash",
  "small_model": "opencode-zen/nemotron-3-ultra-free",
  "default_agent": "smart",
  "subagent_depth": 2,
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000,
    "tail_turns": 5,
    "preserve_recent_tokens": 30000
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "watcher": {
    "globs": ["**"],
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".angular/**",
      "__pycache__/**",
      ".venv/**",
      "venv/**",
      ".cache/**",
      "*.lock",
      "**/*.log",
      "coverage/**",
      ".turbo/**",
      "*.tsbuildinfo"
    ]
  },
  "provider": {
    "opencode-zen": {
      "name": "OpenCode Zen",
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle",
          "limit": {
            "context": 200000,
            "output": 65536
          },
          "tool_call": true
        },
        "mimo-v2.5-free": {
          "name": "MiMo V2.5",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "tool_call": true
        },
        "nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "tool_call": true
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning Free",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "tool_call": true
        },
        "ling-3.0-flash-fin-free": {
          "name": "Ling 3.0 Flash Fin Free",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "tool_call": true
        },
        "muse-spark-1.2-contributor-free": {
          "name": "Muse Spark 1.2 Contributor Free",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "tool_call": true
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "deepseek-ai/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 8192
          },
          "tool_call": true
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "tool_call": true
        },
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "Nemotron 3.5 Lightning",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "tool_call": true
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "tool_call": true
        }
      }
    },
"tokenrouter": {
      "name": "TokenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 Free",
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "tool_call": true
        }
      }
    },
