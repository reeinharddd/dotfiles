{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // LOCAL (dotfiles): caveman compression mode
    "./plugins/caveman/plugin.js",
    // LOCAL (dotfiles): context analysis hook
    "./plugins/ctx-analyze/plugin.ts",
    // LOCAL (ECC): hooks for code-changed-files tracking
    "./plugins/ecc/index.ts",
    // GENTLE-AI (installed): auto-discovers engram.ts, crg-plugin.ts, model-variants.ts, skill-registry.ts
    "/home/reeinharrrd/.opencode/dist/plugins",
    // NPM: Anthropic Agent Skills spec
    "@zenobius/opencode-skillful",
    // NPM: Dynamic Context Pruning (token compression)
    "@tarquinen/opencode-dcp",
    // NPM: Shell strategy for AI agents
    "@bgerona/opencode-shell-non-interactive-strategy",
    // NPM: Multi-track workflow orchestrator
    "opencode-conductor",
    // NPM: Background agent dispatch
    "opencode-background-agents",
    // NPM: Git worktree automation
    "opencode-worktree",
    // NPM: Safety guardrails
    "opencode-vibeguard",
    // NPM: Desktop notifications
    "opencode-notify",
    // NPM: Scheduled jobs
    "opencode-scheduler",
    // NPM: Fast code editing
    "@morphllm/opencode-morph-plugin",
    // NPM: TypeScript type injection
    "@nick-vi/opencode-type-inject",
    // NPM: Web search with citations
    "opencode-websearch-cited",
    // NPM: Time tracking
    "opencode-wakatime",
    // NPM: Power pack commands/skills (waybarrios/opencode-power-pack)
    "opencode-power-pack@git+https://github.com/waybarrios/opencode-power-pack.git",
    // NPM: Primary agent (Sisyphus)
    "oh-my-openagent@latest",
  ],
}
