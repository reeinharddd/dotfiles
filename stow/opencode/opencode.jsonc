    "google": {
      "name": "Google",
      "npm": "@ai-sdk/google",
      "options": {
        "apiKey": "{env:GOOGLE_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash"
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash"
        },
        "gemini-embedding-001": {
          "name": "Gemini Embedding"
        },
        "gemini-embedding-2": {
          "name": "Gemini Embedding 2"
        },
        "gemini-flash-latest": {
          "name": "Gemini Flash Latest"
        },
        "gemini-flash-lite-latest": {
          "name": "Gemini Flash Lite Latest"
        },
        "gemini-omni-flash-preview": {
          "name": "Gemini Omni Flash Preview"
        },
        "gemini-robotics-er-1.6-preview": {
          "name": "Gemini Robotics ER"
        },
        "gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B"
        },
        "gemma-4-31b-it": {
          "name": "Gemma 4 31B"
        },
        "antigravity-gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "medium": { "thinkingConfig": { "thinkingBudget": 16384 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        }
      }
    }
  },
  "enabled_providers": [
    "opencode-zen",
    "tokenrouter",
    "mistral",
    "google",
    "nvidia",
    "openrouter"
  ],
  "disabled_providers": [
    "opencode"
  ],
  "lsp": {
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "dockerfile": {
      "command": [
        "docker-langserver",
        "--stdio"
      ],
      "extensions": [
        "Dockerfile"
      ]
    },
    "go": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "javascript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx"
      ]
    },
    "json": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "markdown": {
      "command": [
        "marksman"
      ],
      "extensions": [
        ".md"
      ]
    },
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "toml": {
      "command": [
        "taplo",
        "lsp",
        "--stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "yaml": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "sql": {
      "command": [
        "sql-language-server",
        "up",
        "--method",
        "stdio"
      ],
      "extensions": [
        ".sql",
        ".pgsql"
      ]
    }
  },
  "formatter": {
    "python": {
      "command": [
        "ruff",
        "format",
        "-"
      ],
      "extensions": [
        ".py"
      ]
    },
    "shell": {
      "command": [
        "shfmt",
        "-"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "javascript": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx"
      ]
    },
    "json": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "markdown": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
      ],
      "extensions": [
        ".md"
      ]
    },
    "yaml": {
      "command": [
        "prettier",
        "--stdin-filepath",
        "{path}"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "go": {
      "command": [
        "gofmt"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
      "command": [
        "rustfmt"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "enabled": true,
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ]
    },
    "firecrawl": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/fc-412aba2a43ba47daabae244cb8a72af9/v2/mcp"
    },
    "codebase-memory": {
      "enabled": true,
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ]
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ]
    },
    "metronous": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/reeinharrrd/.local/bin/metronous",
        "mcp"
      ],
      "_note": "telemetría + benchmarks semanales + calibración de modelos"
    },
    "github": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github@2025.4.8"
      ],
      "_note": "core: PRs, issues, repos en cualquier proyecto"
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--output-dir",
        "/tmp/opencode/playwright"
      ],
      "_note": "browser global aislado (headless/isolated/sin service workers); navegación web habilitada para research y visual QA"
    },
    "filesystem": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10"
      ],
      "_note": "core: acceso multi-repo"
    }
  },
  "plugin": [
    "oh-my-openagent@4.19.4",
    "./plugins/model-routing-guard.js",
    "./plugins/opencode-rtk.js",
    "./plugins/bodega-index.js",
    "./node_modules/@morphllm/opencode-morph-plugin/dist/index.js",
