  "permission": {
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "opencode.env": "deny",
      "vault-key": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git push --force*": "deny",
      "git push*": "ask",
      "sudo*": "ask",
      "wp db reset*": "deny",
      "wp db import*": "ask",
      "wp plugin delete*": "ask",
      "wp theme delete*": "ask",
      "source*opencode.env*": "ask",
      "cat*opencode.env*": "ask",
      "printenv*": "ask",
      "env*": "ask"
    },
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
