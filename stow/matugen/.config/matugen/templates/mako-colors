# Generado por matugen — NO editar a mano
# Colores mako desde wallpaper

default-timeout=5000
border-size=2
border-color={{colors.primary.default.hex}}
background-color={{colors.surface.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-radius=12
font=JetBrainsMono Nerd Font Mono 11
anchor=top-right
max-visible=5
layer=overlay
sort=-time
markup=1
actions=1
format=%a
icon-path=/usr/share/icons/Papirus/24x24/status:/usr/share/icons/Papirus/24x24/actions:/usr/share/icons/Papirus/24x24/places

[urgency=low]
background-color={{colors.surface_container.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-color={{colors.outline.default.hex}}

[urgency=normal]
background-color={{colors.surface.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-color={{colors.primary.default.hex}}

[urgency=critical]
default-timeout=0
background-color={{colors.error_container.default.hex}}
text-color={{colors.on_error_container.default.hex}}
border-color={{colors.error.default.hex}}
