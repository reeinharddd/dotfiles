# Ghostty terminal config — Catppuccin Mocha
# Moderno, profesional, facil para los ojos
# https://ghostty.org/docs/configuration

# -------------------------------------------------------------------
# Theme — Catppuccin Mocha (built-in, uno de los mejores temas dark)
# -------------------------------------------------------------------
theme = Catppuccin Mocha

# -------------------------------------------------------------------
# Font
# -------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font Mono
font-size = 12

# -------------------------------------------------------------------
# Window
# -------------------------------------------------------------------
background-opacity = 0.95
window-padding-x = 4
window-padding-y = 4
window-padding-color = background
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# -------------------------------------------------------------------
# Cursor
# -------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false

# -------------------------------------------------------------------
# Shell
# -------------------------------------------------------------------
shell-integration = zsh
shell-integration-features = cursor,no-sudo,title,path
term = xterm-ghostty

# -------------------------------------------------------------------
# Keybindings — solo overrides sobre defaults
# https://ghostty.org/docs/configuration/keybind
# -------------------------------------------------------------------
# Ventana nueva (default: ctrl+shift+n)
keybind = super+shift+n=new_window

# Font size con super (default: ctrl +/-/0)
keybind = super+plus=increase_font_size
keybind = super+minus=decrease_font_size
keybind = super+0=reset_font_size

# Recargar config
keybind = super+shift+,=reload_config
