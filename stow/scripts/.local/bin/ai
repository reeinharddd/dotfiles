#!/usr/bin/env bash
# ai — Wrapper to run opencode with profile-specific env (no ~/.env on disk)
# Usage: ai [personal|client] [opencode args...]

set -euo pipefail

PROFILE="${1:-personal}"
shift || true

# Validate profile
if [[ ! "$PROFILE" =~ ^(personal|client)$ ]]; then
    echo "Usage: ai [personal|client] [opencode args...]"
    exit 1
fi

# Check sops and age key
if ! command -v sops &>/dev/null; then
    echo "ERROR: sops not installed. Run: mise install sops"
    exit 1
fi

AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
if [[ ! -f "$AGE_KEY_FILE" ]]; then
    echo "ERROR: Age key not found at $AGE_KEY_FILE"
    echo "Generate with: age-keygen -o $AGE_KEY_FILE"
    exit 1
fi

# Check encrypted env file
ENV_SOPS_FILE="$HOME/projects/personal/dotfiles/.env.sops.$PROFILE"
if [[ ! -f "$ENV_SOPS_FILE" ]]; then
    echo "ERROR: Encrypted env file not found: $ENV_SOPS_FILE"
    echo "Create with: sops --encrypt --input-type dotenv --output-type dotenv --age \$(cat $AGE_KEY_FILE | grep -o 'age1[^ ]*') <(echo 'KEY=value') > $ENV_SOPS_FILE"
    exit 1
fi

# Run opencode with decrypted env (never writes ~/.env to disk)
export DOTFILES_DIR="$HOME/projects/personal/dotfiles"
export AI_PROFILE="$PROFILE"

# Load profile-specific config
PROFILE_FILE="$HOME/projects/personal/dotfiles/stow/opencode/.config/opencode/profile.$PROFILE"
if [[ -f "$PROFILE_FILE" ]]; then
    export AI_PROFILE_FILE="$PROFILE_FILE"
fi

# Decrypt and run in one command - env vars only exist in this process
exec sops exec-env "$ENV_SOPS_FILE" "sandbox-run --profile $PROFILE -- opencode $*"
