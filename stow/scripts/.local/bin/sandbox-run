#!/usr/bin/env bash
# sandbox-run — Run a command inside a bubblewrap sandbox
# Usage: sandbox-run [--profile personal|client] -- command [args...]
#
# Profiles:
#   personal: full access to $HOME, network to AI providers
#   client:   restricted $HOME (project only), no secrets, network allowlist

set -euo pipefail

PROFILE="personal"
ARGS=()

# Parse args
while [[ $# -gt 0 ]]; do
    case $1 in
        --profile)
            PROFILE="$2"
            shift 2
            ;;
        --)
            shift
            ARGS=("$@")
            break
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
    echo "Usage: sandbox-run [--profile personal|client] -- command [args...]"
    exit 1
fi

# Resolve command
CMD="${ARGS[0]}"
if [[ ! "$CMD" = /* ]] && [[ ! "$CMD" = ./* ]]; then
    CMD_PATH=$(command -v "$CMD" 2>/dev/null || true)
    if [[ -z "$CMD_PATH" ]]; then
        echo "Command not found: $CMD"
        exit 1
    fi
    CMD="$CMD_PATH"
fi

# Sandbox configuration per profile
case "$PROFILE" in
    personal)
        # Personal profile: full $HOME access, network to AI providers
        BIND_RO=(
            /usr /bin /lib /lib64 /etc /run /sys /dev /proc /tmp
        )
        BIND_RW=(
            "$HOME"
        )
        NETWORK_ALLOW=true
        ;;
    client)
        # Client profile: restricted to project dir, no secrets, limited network
        PROJECT_DIR="${OPENCODE_PROJECT_DIR:-$(pwd)}"
        BIND_RO=(
            /usr /bin /lib /lib64 /etc /run /sys /dev /proc /tmp
        )
        BIND_RW=(
            "$PROJECT_DIR"
        )
        NETWORK_ALLOW=false
        ;;
    *)
        echo "Unknown profile: $PROFILE"
        exit 1
        ;;
esac

# Build bwrap command
BWRAP_ARGS=(
    --die-with-parent
    --unshare-all
    --cap-drop ALL
    --proc /proc
    --dev /dev
    --chdir "$(pwd)"
)

# Add read-only binds
for dir in "${BIND_RO[@]}"; do
    [[ -d "$dir" ]] && BWRAP_ARGS+=(--ro-bind "$dir" "$dir")
done

# Add read-write binds
for dir in "${BIND_RW[@]}"; do
    [[ -d "$dir" ]] && BWRAP_ARGS+=(--bind "$dir" "$dir")
done

# Network
if [[ "$NETWORK_ALLOW" = true ]]; then
    BWRAP_ARGS+=(--share-net)
else
    BWRAP_ARGS+=(--unshare-net)
fi

# Environment
BWRAP_ARGS+=(--setenv PATH "$PATH")
BWRAP_ARGS+=(--setenv HOME "$HOME")
BWRAP_ARGS+=(--setenv USER "$USER")
BWRAP_ARGS+=(--setenv SHELL "$SHELL")
BWRAP_ARGS+=(--setenv TERM "${TERM:-xterm-256color}")

# Execute
exec bwrap "${BWRAP_ARGS[@]}" -- "$CMD" "${ARGS[@]:1}"