[Unit]
Description=Metronous Agent Intelligence Daemon
After=network.target

[Service]
Type=simple
ExecStart=/home/reeinharrrd/.local/bin/metronous server --data-dir /home/reeinharrrd/.metronous/data --daemon-mode
Restart=on-failure
RestartSec=5s
StandardOutput=append:%h/.metronous/metronous.log
StandardError=inherit

[Install]
WantedBy=default.target
