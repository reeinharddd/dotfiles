# Mako config — minimal working
default-timeout=5000
border-size=2
border-color=#cba6f7
background-color=#1e1e2e
text-color=#cdd6f4
border-radius=12
font=JetBrainsMono Nerd Font Mono 11
anchor=top-right
max-visible=5
layer=overlay
sort=-time
markup=1
actions=1
format=%a
icon-path=/usr/share/icons/Papirus/24x24/status:/usr/share/icons/Papirus/24x24/actions:/usr/share/icons/Papirus/24x24/places

[urgency=low]
background-color=#313244
text-color=#cdd6f4
border-color=#585b70

[urgency=normal]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7

[urgency=critical]
default-timeout=0
background-color=#f38ba8
text-color=#1e1e2e
border-color=#f38ba8
