#!/usr/bin/env bash
# pre-commit — Verify opencode config integrity before committing
set -euo pipefail

echo "==> [pre-commit] Verifying opencode config..."
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)/scripts"

# Only run if opencode configs changed
if git diff --cached --name-only | grep -q "^configs/opencode/"; then
  if [ -f "$SCRIPT_DIR/verify-opencode.sh" ]; then
    "$SCRIPT_DIR/verify-opencode.sh" --quiet || {
      echo "  FAIL  opencode config verification failed."
      echo "  HINT  Run ./scripts/verify-opencode.sh to see details."
      echo "  HINT  To skip: git commit --no-verify"
      exit 1
    }
  fi
fi
