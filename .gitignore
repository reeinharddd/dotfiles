# Backup directory (created by deploy.sh)
.local/share/dotfiles-backup/

# macOS
.DS_Store

# Editor
*.swp
*.swo

# Bootstrap temp
bootstrap/*.tmp
.gitignore
antigravity-accounts.json
antigravity-accounts.json.*.tmp
antigravity-signature-cache.json
antigravity-logs/

# Never-commit sensitive files
.env.providers
opencode.env
# Generated strict-JSON mirror of opencode.jsonc for metronous agent-model lookup
stow/opencode/.config/opencode/opencode.json

# matugen generated artifacts (live inside stow via dir-symlinks)
stow/hyprland/.config/hypr/matugen-colors.conf
stow/mako/.config/mako/colors
stow/waybar/.config/waybar/colors.css
